# Environment variables for running the server locally.
# Copy to server/.env (git ignores .env), fill in, then from server/:
#   set -a; source .env; set +a; python server.py
# On Cloud Run, deploy.sh sets all of these for you.

GOOGLE_CLIENT_ID=<client-id>
GOOGLE_CLIENT_SECRET=<client-secret>
BASE_URL=http://localhost:8080
# Any long random string, e.g. output of: openssl rand -hex 32
JWT_SIGNING_KEY=<random-string>
# Only accounts on this domain can use the server
ALLOWED_DOMAIN=<your-domain>

# Local runs store sign in sessions on disk instead of Firestore
STORAGE_BACKEND=local

# Only needed with STORAGE_BACKEND=firestore:
# GOOGLE_CLOUD_PROJECT=<project-id>
# STORAGE_ENCRYPTION_KEY=<fernet-key>
# FIRESTORE_DATABASE=(default)

# For a local sign in, add http://localhost:8080/auth/callback as a redirect URI on the OAuth client.
